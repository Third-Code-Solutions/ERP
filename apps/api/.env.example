# Core API reads apps/api/.env when started with pnpm --filter @third-code-erp/api dev.
# Use the same isolated Supabase project as the Web service. Never commit filled files.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
REDIS_URL=redis://127.0.0.1:6379
ERP_API_CORS_ORIGINS=http://localhost:3000
# Feature-specific gates and credentials: ../../docs/ENVIRONMENT_VARIABLES.md.
# Keep tenant allowlists empty until the relevant workflow has been verified.
