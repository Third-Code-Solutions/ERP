{
  "name": "@third-code-erp/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:fresh": "rm -rf .next .turbo && next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:worker": "../workers/dxf-parser/run-local.sh",
    "demo:warm": "node scripts/warm-routes.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'lint: TS-only checks for now (next lint deprecated, eslint flat config not yet configured)' && tsc --noEmit && tsc --noEmit -p e2e/cortex-index.tsconfig.json && tsc --noEmit -p e2e/finance-ledger.tsconfig.json && tsc --noEmit -p e2e/finance-receivables.tsconfig.json && tsc --noEmit -p e2e/finance-payables.tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/cortex-index.tsconfig.json && tsc --noEmit -p e2e/finance-ledger.tsconfig.json && tsc --noEmit -p e2e/finance-receivables.tsconfig.json && tsc --noEmit -p e2e/finance-payables.tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cortex-index-local": "playwright test --config=playwright.cortex-index.config.ts",
    "test:e2e:cortex-route-local": "playwright test --config=playwright.cortex-route.config.ts",
    "test:e2e:bank-statement-storage-local": "playwright test --config=playwright.bank-statement-storage.config.ts",
    "test:e2e:finance-ledger-local": "pnpm --filter @third-code-erp/api build && playwright test --config=playwright.finance-ledger.config.ts",
    "test:e2e:finance-receivables-local": "pnpm --filter @third-code-erp/api build && playwright test --config=playwright.finance-receivables.config.ts",
    "test:e2e:finance-payables-local": "pnpm --filter @third-code-erp/api build && playwright test --config=playwright.finance-payables.config.ts",
    "test:e2e:cortex-generation-local": "pnpm --filter @third-code-erp/api build && playwright test --config=playwright.cortex-generation.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.48.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@third-code-erp/ai": "workspace:*",
    "@third-code-erp/auth": "workspace:*",
    "@third-code-erp/database": "workspace:*",
    "@third-code-erp/shared-types": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.177",
    "d3-force": "^3.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.40.1",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "inngest": "^4.3.0",
    "mammoth": "^1.12.0",
    "next": "^15.3.1",
    "openai": "^6.37.0",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@third-code-erp/config": "workspace:*",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "7.3.3",
    "vitest": "^3.2.4"
  }
}
