# ABI OPS — Web App Environment Variables
# Copy this file to .env.local and fill in real values from your Supabase project dashboard

# Canonical public origin. Change this for Vercel or any alternative host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (Supabase Postgres connection string)
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Incremental NestJS transaction authority. Keep false until API readiness,
# compatibility, authorization, and rollback gates pass in preview.
ERP_CORE_API_URL=http://localhost:3001
ERP_PROJECT_WRITES_VIA_API=false
ERP_RFQ_QUOTE_WRITES_VIA_API=false
ERP_RFQ_TRANSITION_WRITES_VIA_API=false
ERP_RFQ_AWARD_WRITES_VIA_API=false
# Comma-separated tenant UUIDs. Both this allowlist and the exact `true` flag
# are required. Use `*` alone only after every tenant is approved for cutover.
ERP_PROJECT_WRITES_VIA_API_TENANT_IDS=
ERP_RFQ_QUOTE_WRITES_VIA_API_TENANT_IDS=
ERP_RFQ_TRANSITION_WRITES_VIA_API_TENANT_IDS=
ERP_RFQ_AWARD_WRITES_VIA_API_TENANT_IDS=

# Optional production CAD evidence worker. Keep both values server-only.
DXF_PARSER_URL=http://localhost:8000
PARSER_SHARED_SECRET=replace-with-private-worker-secret
# Only set for local development. Production must keep this false/unset.
PARSER_ALLOW_UNAUTHENTICATED_LOCAL=false
