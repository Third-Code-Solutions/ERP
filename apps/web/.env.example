# Third Code ERP — Web App Environment Variables
# Copy this file to .env.local and fill in real values from your Supabase project dashboard

# Canonical public origin. Change this for Vercel or any alternative host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (Supabase Postgres connection string)
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Incremental NestJS transaction authority. Keep false until API readiness,
# compatibility, authorization, and rollback gates pass in preview.
ERP_CORE_API_URL=http://localhost:3001
ERP_PROJECT_WRITES_VIA_API=false
ERP_PO_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API=false
ERP_CHANGE_REQUEST_WRITES_VIA_API=false
# Delivery receipt delegation. Keep disabled until hosted reconciliation and
# one tenant canary prove the Nest transaction and replay behavior.
ERP_DELIVERY_RECEIPT_WRITES_VIA_API=false
# Delivery site-preparation start canary. Keep disabled until the Nest
# transaction, replay, tenant authorization, and rollback gates are verified.
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API=false
# Delivery site-preparation completion canary. Keep disabled until the Nest
# transaction, replay, tenant authorization, and rollback gates are verified.
ERP_DELIVERY_SITE_PREPARATION_COMPLETE_WRITES_VIA_API=false
# Delivery inspection start canary. Keep disabled until the Nest transaction,
# replay, tenant authorization, and rollback gates are verified.
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API=false
# Delivery inspection completion canary. Keep disabled until Nest terminal
# transaction, replay, tenant authorization, and rollback gates pass.
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API=false
ERP_DELIVERY_CANCEL_WRITES_VIA_API=false
# Stock Receipt creation canary. Keep disabled until the Nest transaction,
# tenant authorization, idempotency, and rollback gates are verified.
ERP_INVENTORY_RECEIPT_CREATE_VIA_API=false
# Stock Receipt post/reversal canaries. Both the exact `true` flag and the
# tenant allowlist are required; leave disabled until hosted cutover gates pass.
ERP_INVENTORY_RECEIPT_POST_VIA_API=false
ERP_INVENTORY_RECEIPT_REVERSE_VIA_API=false
# CAD processing canary. Keep disabled until Nest worker, evidence-commit, and
# status-polling gates are verified for one tenant.
ERP_DOCUMENT_PROCESSING_VIA_API=false
# Comma-separated tenant UUIDs. Both this allowlist and the exact `true` flag
# are required. Use `*` alone only after every tenant is approved for cutover.
ERP_PROJECT_WRITES_VIA_API_TENANT_IDS=
ERP_PO_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_CHANGE_REQUEST_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_RECEIPT_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_SITE_PREPARATION_COMPLETE_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_CANCEL_WRITES_VIA_API_TENANT_IDS=
ERP_INVENTORY_RECEIPT_CREATE_TENANT_IDS=
ERP_INVENTORY_RECEIPT_POST_TENANT_IDS=
ERP_INVENTORY_RECEIPT_REVERSE_TENANT_IDS=
ERP_DOCUMENT_PROCESSING_TENANT_IDS=
