# Third Code ERP — Web App Environment Variables
# Copy this file to .env.local and fill in real values from your Supabase project dashboard

# Canonical public origin. Change this for Vercel or any alternative host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (Supabase Postgres connection string)
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Incremental NestJS transaction authority. Keep false until API readiness,
# compatibility, authorization, and rollback gates pass in preview.
ERP_CORE_API_URL=http://localhost:3001
# Project detail reads stay on the existing path until the Nest read canary
# and protected browser evidence are complete.
ERP_PROJECT_READS_VIA_API=false
# Project collection reads stay on the existing path until the Nest list
# contract, pagination, and protected browser canary are complete.
ERP_PROJECT_LISTS_VIA_API=false
ERP_ACCOUNT_READS_VIA_API=false
ERP_ACCOUNT_KYC_QUEUE_READS_VIA_API=false
ERP_OPPORTUNITY_READS_VIA_API=false
# Inventory summary reads stay on the existing server-side path until the
# Nest contract, tenant authorization, and protected browser canary pass.
ERP_INVENTORY_SUMMARY_READS_VIA_API=false
ERP_INVENTORY_STOCK_MOVEMENT_READS_VIA_API=false
ERP_INVENTORY_STOCK_MOVEMENT_DETAIL_READS_VIA_API=false
# Posted general-ledger reads stay on the existing server-side path until the
# Nest contract and protected finance tenant canary are approved.
ERP_FINANCE_LEDGER_READS_VIA_API=false
# Customer receivables reads stay on the existing server-side path until the
# Nest contract, invoice/allocation parity, and protected finance canary pass.
ERP_FINANCE_RECEIVABLES_READS_VIA_API=false
# Supplier payables reads stay on the existing server-side path until the
# Nest contract, supplier-bill/allocation parity, and protected finance canary pass.
ERP_FINANCE_PAYABLES_READS_VIA_API=false
ERP_PROJECT_CREATE_WRITES_VIA_API=false
ERP_COST_ENTRY_CREATE_WRITES_VIA_API=false
ERP_PROJECT_WRITES_VIA_API=false
ERP_ACCOUNT_KYC_QUEUE_READS_VIA_API_TENANT_IDS=
ERP_PO_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API=false
ERP_CHANGE_REQUEST_WRITES_VIA_API=false
# Supplier Bill posting canary. Keep disabled until the Nest payable function,
# idempotency, audit, and one-tenant rollback gates are verified.
ERP_FINANCE_SUPPLIER_BILL_POST_WRITES_VIA_API=false
ERP_FINANCE_SUPPLIER_BILL_REVERSE_WRITES_VIA_API=false
# Cash posting/reversal canary. Keep disabled until Core transaction,
# idempotency, audit, and one-tenant rollback gates pass.
ERP_FINANCE_CASH_WORKFLOW_WRITES_VIA_API=false
# Cash draft create/update/delete canary. Keep disabled until the Core
# transaction, idempotency, audit, and one-tenant rollback gates pass.
ERP_FINANCE_CASH_DRAFT_WRITES_VIA_API=false
ERP_FINANCE_CUSTOMER_INVOICE_ISSUE_WRITES_VIA_API=false
# Customer invoice reversal canary. Keep disabled until the Core transaction,
# idempotency, audit, and one-tenant rollback gates are verified.
ERP_FINANCE_CUSTOMER_INVOICE_REVERSE_WRITES_VIA_API=false
# Customer invoice cancellation canary. Keep disabled until the Core
# transaction, idempotency, audit, and one-tenant rollback gates pass.
ERP_FINANCE_CUSTOMER_INVOICE_CANCEL_WRITES_VIA_API=false
# Delivery receipt delegation. Keep disabled until hosted reconciliation and
# one tenant canary prove the Nest transaction and replay behavior.
ERP_DELIVERY_RECEIPT_WRITES_VIA_API=false
# Delivery site-preparation start canary. Keep disabled until the Nest
# transaction, replay, tenant authorization, and rollback gates are verified.
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API=false
# Delivery site-preparation completion canary. Keep disabled until the Nest
# transaction, replay, tenant authorization, and rollback gates are verified.
ERP_DELIVERY_SITE_PREPARATION_COMPLETE_WRITES_VIA_API=false
# Delivery inspection start canary. Keep disabled until the Nest transaction,
# replay, tenant authorization, and rollback gates are verified.
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API=false
# Delivery inspection completion canary. Keep disabled until Nest terminal
# transaction, replay, tenant authorization, and rollback gates pass.
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API=false
ERP_DELIVERY_CANCEL_WRITES_VIA_API=false
# Stock Receipt creation canary. Keep disabled until the Nest transaction,
# tenant authorization, idempotency, and rollback gates are verified.
ERP_INVENTORY_RECEIPT_CREATE_VIA_API=false
# Stock Movement draft creation stays disabled until the Core idempotency
# ledger, disposable transaction proof, and tenant canary are approved.
ERP_INVENTORY_STOCK_MOVEMENT_CREATE_VIA_API=false
ERP_INVENTORY_STOCK_MOVEMENT_WORKFLOW_VIA_API=false
# Stock Receipt post/reversal canaries. Both the exact `true` flag and the
# tenant allowlist are required; leave disabled until hosted cutover gates pass.
ERP_INVENTORY_RECEIPT_POST_VIA_API=false
ERP_INVENTORY_RECEIPT_REVERSE_VIA_API=false
# Item policy writes remain on the Next compatibility path until the Nest
# transaction and protected tenant canary are approved.
ERP_INVENTORY_ITEM_CONFIG_VIA_API=false
# UOM setup writes remain on the Next compatibility path until the Nest
# transaction and protected tenant canary are approved.
ERP_INVENTORY_UOM_CREATE_VIA_API=false
# Warehouse setup writes remain on the Next compatibility path until the Nest
# transaction and protected tenant canary are approved.
ERP_INVENTORY_WAREHOUSE_CREATE_VIA_API=false
# Warehouse name/state updates remain on the Next compatibility path until
# the Nest transaction and protected tenant canary are approved.
ERP_INVENTORY_WAREHOUSE_UPDATE_VIA_API=false
ERP_INVENTORY_WAREHOUSE_CLOSEOUT_READS_VIA_API=false
# CAD processing canary. Keep disabled until Nest worker, evidence-commit, and
# status-polling gates are verified for one tenant.
ERP_DOCUMENT_PROCESSING_VIA_API=false
ERP_DOCUMENT_DELETE_WRITES_VIA_API=false
# Public canvas-signing canary. Keep disabled until the Nest route, Storage,
# replay, and portal handoff are verified for one tenant.
ERP_PUBLIC_SIGNING_VIA_API=false
# Comma-separated tenant UUIDs. Both this allowlist and the exact `true` flag
# are required. Use `*` alone only after every tenant is approved for cutover.
ERP_PROJECT_WRITES_VIA_API_TENANT_IDS=
ERP_PROJECT_READS_VIA_API_TENANT_IDS=
ERP_PROJECT_LISTS_VIA_API_TENANT_IDS=
ERP_ACCOUNT_READS_VIA_API_TENANT_IDS=
ERP_OPPORTUNITY_READS_VIA_API_TENANT_IDS=
ERP_INVENTORY_SUMMARY_READS_VIA_API_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_READS_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_DETAIL_READS_TENANT_IDS=
ERP_FINANCE_LEDGER_READS_VIA_API_TENANT_IDS=
ERP_PROJECT_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_COST_ENTRY_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_CHANGE_REQUEST_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_SUPPLIER_BILL_POST_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_SUPPLIER_BILL_REVERSE_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_CASH_WORKFLOW_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_CASH_DRAFT_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_CUSTOMER_INVOICE_ISSUE_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_CUSTOMER_INVOICE_REVERSE_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_CUSTOMER_INVOICE_CANCEL_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_RECEIPT_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_SITE_PREPARATION_COMPLETE_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_CANCEL_WRITES_VIA_API_TENANT_IDS=
ERP_INVENTORY_RECEIPT_CREATE_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_CREATE_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_WORKFLOW_TENANT_IDS=
ERP_INVENTORY_RECEIPT_POST_TENANT_IDS=
ERP_INVENTORY_RECEIPT_REVERSE_TENANT_IDS=
ERP_INVENTORY_ITEM_CONFIG_TENANT_IDS=
ERP_INVENTORY_UOM_CREATE_TENANT_IDS=
ERP_INVENTORY_WAREHOUSE_CREATE_TENANT_IDS=
ERP_INVENTORY_WAREHOUSE_UPDATE_TENANT_IDS=
ERP_INVENTORY_WAREHOUSE_CLOSEOUT_READS_TENANT_IDS=
ERP_DOCUMENT_PROCESSING_TENANT_IDS=
ERP_DOCUMENT_DELETE_WRITES_VIA_API_TENANT_IDS=
ERP_PUBLIC_SIGNING_VIA_API_TENANT_IDS=
