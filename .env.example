# ============================================
# ABI OPS Construction Operations — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Public application origin. Set this to the canonical production hostname for
# metadata, structured data, portal links, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres direct connection)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# NestJS ERP Core API (feature-flagged migration path)
ERP_CORE_API_URL=http://localhost:3001
ERP_PROJECT_WRITES_VIA_API=false
ERP_RFQ_QUOTE_WRITES_VIA_API=false
ERP_RFQ_TRANSITION_WRITES_VIA_API=false
ERP_RFQ_AWARD_WRITES_VIA_API=false
ERP_RFQ_AWARD_WRITES_VIA_API_TENANT_IDS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
REDIS_URL=redis://localhost:6379
ERP_API_CORS_ORIGINS=http://localhost:3000

# Supabase Storage
SUPABASE_STORAGE_BUCKET=project-documents

# Optional: Upstash Redis (rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Inngest (background jobs)
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Closed by default until hosted M-06 schema and rollout gates pass.
PROCESS_SLA_ENGINE_ENABLED=0
# Closed by default until tenant holiday schema and RLS/audit gates pass.
BUSINESS_CALENDAR_DB_ENABLED=0

# DXF Parser Worker (Railway)
# DXF_PARSER_URL=https://your-dxf-parser.railway.app

# OpenAI (required for AI BOM suggestions and project chat)
# Enables: similar item retrieval, streaming chat, BOM embedding on approval
OPENAI_API_KEY=sk-...
