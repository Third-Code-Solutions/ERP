# ============================================
# Third Code ERP Construction ERP — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Public application origin. Set this to the canonical production hostname for
# metadata, structured data, portal links, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres direct connection)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# NestJS ERP Core API (feature-flagged migration path)
ERP_CORE_API_URL=http://localhost:3001
# Cortex graph reads remain on the existing server path until the derived
# graph, role scope, and one-tenant Nest canary are approved.
ERP_CORTEX_GRAPH_READS_ENABLED=false
ERP_CORTEX_GRAPH_READS_TENANT_IDS=
ERP_CORTEX_GRAPH_READS_VIA_API=false
ERP_CORTEX_GRAPH_READS_VIA_API_TENANT_IDS=
# Citation-backed Cortex entity reads stay on the existing path until the
# contract, role scope, and a protected Nest canary are approved.
ERP_CORTEX_ENTITY_READS_ENABLED=false
ERP_CORTEX_ENTITY_READS_TENANT_IDS=
ERP_CORTEX_ENTITY_READS_VIA_API=false
ERP_CORTEX_ENTITY_READS_VIA_API_TENANT_IDS=
# Shared Redis provider quota canary. Keep false/empty until Nest API and
# Redis readiness, auth, replay, and spend gates are approved for one tenant.
ERP_PROVIDER_QUOTA_VIA_API=false
ERP_PROVIDER_QUOTA_VIA_API_TENANT_IDS=
# Project detail reads remain on the existing Next/DB path until a tenant
# canary proves the Nest read contract and protected browser behavior.
ERP_PROJECT_READS_VIA_API=false
ERP_PROJECT_READS_VIA_API_TENANT_IDS=
# Project collection reads stay on the existing Next/DB path until the same
# tenant-scoped list contract and pagination replay gates pass.
ERP_PROJECT_LISTS_VIA_API=false
ERP_PROJECT_LISTS_VIA_API_TENANT_IDS=
# Project Audit activity reads switch to the redacted Nest projection only for
# an explicitly approved tenant. The legacy DB projection remains the default.
ERP_AUDIT_ACTIVITY_READS_VIA_API=false
ERP_AUDIT_ACTIVITY_READS_VIA_API_TENANT_IDS=
# CRM account reads stay on the existing Next/DB path until the Nest contract
# and protected browser canary are verified.
ERP_ACCOUNT_READS_VIA_API=false
ERP_ACCOUNT_READS_VIA_API_TENANT_IDS=
# KYC queue reads stay on the existing Next/DB path until the Nest contract
# and protected finance browser canary are verified.
ERP_ACCOUNT_KYC_QUEUE_READS_VIA_API=false
ERP_ACCOUNT_KYC_QUEUE_READS_VIA_API_TENANT_IDS=
# Opportunity detail reads stay on the existing Next/DB path until the Nest
# contract and protected CRM browser canary are verified.
ERP_OPPORTUNITY_READS_VIA_API=false
ERP_OPPORTUNITY_READS_VIA_API_TENANT_IDS=
# Inventory summary reads remain on the existing Next/DB path until the Nest
# contract and protected tenant browser canary are approved.
ERP_INVENTORY_SUMMARY_READS_VIA_API=false
ERP_INVENTORY_SUMMARY_READS_VIA_API_TENANT_IDS=
ERP_ASSET_READS_VIA_API=false
ERP_ASSET_READS_VIA_API_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_READS_VIA_API=false
ERP_INVENTORY_STOCK_MOVEMENT_READS_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_DETAIL_READS_VIA_API=false
ERP_INVENTORY_STOCK_MOVEMENT_DETAIL_READS_TENANT_IDS=
ERP_OPPORTUNITY_CONVERT_WRITES_VIA_API=false
ERP_OPPORTUNITY_CONVERT_WRITES_VIA_API_TENANT_IDS=
# Privileged user-role assignment canary. Keep both sides disabled until the
# browser DML revocation and protected tenant replay are approved.
ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_VIA_API=false
ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_VIA_API_TENANT_IDS=
ERP_PO_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API=false
# Togal BOM line commits remain on the Next compatibility path until the
# service-only ledger, parity replay, and one-tenant canary are approved.
ERP_BOM_TOGAL_COMMIT_VIA_API=false
ERP_BOM_TOGAL_COMMIT_VIA_API_TENANT_IDS=
ERP_INVENTORY_RECEIPT_CREATE_VIA_API=false
ERP_INVENTORY_RECEIPT_CREATE_TENANT_IDS=
# Stock Movement draft creation stays disabled until the idempotency ledger,
# disposable transaction proof, and tenant canary are approved.
ERP_INVENTORY_STOCK_MOVEMENT_CREATE_VIA_API=false
ERP_INVENTORY_STOCK_MOVEMENT_CREATE_TENANT_IDS=
# Keep Stock Receipt posting/reversal delegated writes disabled until the
# Nest transaction, idempotency, authorization, and rollback gates are approved.
ERP_INVENTORY_RECEIPT_POST_VIA_API=false
ERP_INVENTORY_RECEIPT_POST_TENANT_IDS=
ERP_INVENTORY_RECEIPT_REVERSE_VIA_API=false
ERP_INVENTORY_RECEIPT_REVERSE_TENANT_IDS=
# Item policy writes remain on the Next compatibility path until the Nest
# transaction and protected tenant canary are approved.
ERP_INVENTORY_ITEM_CONFIG_VIA_API=false
ERP_INVENTORY_ITEM_CONFIG_TENANT_IDS=
# UOM setup writes remain on the Next compatibility path until the Nest
# transaction and protected tenant canary are approved.
ERP_INVENTORY_UOM_CREATE_VIA_API=false
ERP_INVENTORY_UOM_CREATE_TENANT_IDS=
# Warehouse setup writes remain on the Next compatibility path until the Nest
# transaction and protected tenant canary are approved.
ERP_INVENTORY_WAREHOUSE_CREATE_VIA_API=false
ERP_INVENTORY_WAREHOUSE_CREATE_TENANT_IDS=
# Warehouse name/state updates remain on the Next compatibility path until
# the Nest transaction and protected tenant canary are approved.
ERP_INVENTORY_WAREHOUSE_UPDATE_VIA_API=false
ERP_INVENTORY_WAREHOUSE_UPDATE_TENANT_IDS=
# Warehouse closeout is read-only and remains on the Next/DB path until the
# protected Nest canary and reconciliation checks are approved.
ERP_INVENTORY_WAREHOUSE_CLOSEOUT_READS_VIA_API=false
ERP_INVENTORY_WAREHOUSE_CLOSEOUT_READS_TENANT_IDS=
ERP_PO_CREATE_WRITES_ENABLED=false
ERP_PROJECT_CREATE_WRITES_ENABLED=false
ERP_COST_ENTRY_CREATE_WRITES_ENABLED=false
ERP_COST_ENTRY_DELETE_WRITES_ENABLED=false
ERP_COST_ENTRY_RESTORE_WRITES_ENABLED=false
ERP_OPPORTUNITY_CONVERT_WRITES_ENABLED=false
ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_ENABLED=false
ERP_PO_BOM_CREATE_WRITES_ENABLED=false
ERP_PO_BOM_GROUPED_CREATE_WRITES_ENABLED=false
# Nest Togal BOM authority stays fail-closed until hosted migration/parity and
# a protected tenant canary are approved.
ERP_BOM_TOGAL_COMMIT_WRITES_ENABLED=false
# Comma-separated tenant UUIDs. Keep empty until PO transaction canary is approved.
ERP_PO_CREATE_WRITES_TENANT_IDS=
ERP_PROJECT_CREATE_WRITES_TENANT_IDS=
ERP_COST_ENTRY_CREATE_WRITES_TENANT_IDS=
ERP_COST_ENTRY_DELETE_WRITES_TENANT_IDS=
ERP_COST_ENTRY_RESTORE_WRITES_TENANT_IDS=
ERP_OPPORTUNITY_CONVERT_WRITES_TENANT_IDS=
ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_TENANT_IDS=
ERP_PO_BOM_CREATE_WRITES_TENANT_IDS=
ERP_PO_BOM_GROUPED_CREATE_WRITES_TENANT_IDS=
ERP_BOM_TOGAL_COMMIT_WRITES_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_CREATE_WRITES_ENABLED=false
ERP_INVENTORY_STOCK_MOVEMENT_CREATE_WRITES_TENANT_IDS=
ERP_INVENTORY_STOCK_MOVEMENT_WORKFLOW_WRITES_ENABLED=false
ERP_INVENTORY_STOCK_MOVEMENT_WORKFLOW_WRITES_TENANT_IDS=
ERP_INVENTORY_ITEM_CONFIG_WRITES_ENABLED=false
ERP_INVENTORY_ITEM_CONFIG_WRITES_TENANT_IDS=
ERP_INVENTORY_UOM_CREATE_WRITES_ENABLED=false
ERP_INVENTORY_UOM_CREATE_WRITES_TENANT_IDS=
ERP_INVENTORY_WAREHOUSE_CREATE_WRITES_ENABLED=false
ERP_INVENTORY_WAREHOUSE_CREATE_WRITES_TENANT_IDS=
ERP_INVENTORY_WAREHOUSE_UPDATE_WRITES_ENABLED=false
ERP_INVENTORY_WAREHOUSE_UPDATE_WRITES_TENANT_IDS=
ERP_CHANGE_REQUEST_WRITES_ENABLED=false
ERP_CHANGE_REQUEST_WRITES_TENANT_IDS=
ERP_PO_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API_TENANT_IDS=
# Keep workflow delegation disabled until notification parity and canary proof.
ERP_PO_WORKFLOW_WRITES_VIA_API=false
ERP_PO_WORKFLOW_WRITES_VIA_API_TENANT_IDS=
# Keep PO approval transitions disabled until hosted reconciliation and canary.
ERP_PO_WORKFLOW_WRITES_ENABLED=false
ERP_PO_WORKFLOW_WRITES_TENANT_IDS=
ERP_PO_WORKFLOW_NOTIFICATIONS_ENABLED=false
ERP_PO_WORKFLOW_NOTIFICATIONS_TENANT_IDS=
# Delivery schedule creation delegation stays disabled until the server-owned
# ledger, notification parity, and one-tenant canary are approved.
ERP_DELIVERY_SCHEDULE_CREATE_WRITES_VIA_API=false
ERP_DELIVERY_SCHEDULE_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_SCHEDULE_CREATE_WRITES_ENABLED=false
ERP_DELIVERY_SCHEDULE_CREATE_WRITES_TENANT_IDS=
# Delivery receipt delegation stays disabled until the new request ledger and
# a tenant canary are approved.
ERP_DELIVERY_RECEIPT_WRITES_VIA_API=false
ERP_DELIVERY_RECEIPT_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_RECEIPT_WRITES_ENABLED=false
ERP_DELIVERY_RECEIPT_WRITES_TENANT_IDS=
# Delivery in-transit delegation stays disabled until the request ledger and
# a tenant canary are approved.
ERP_DELIVERY_MARK_IN_TRANSIT_WRITES_VIA_API=false
ERP_DELIVERY_MARK_IN_TRANSIT_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_MARK_IN_TRANSIT_WRITES_ENABLED=false
ERP_DELIVERY_MARK_IN_TRANSIT_WRITES_TENANT_IDS=
# Delivery site-preparation start delegation stays disabled until the ledger
# extension and a tenant canary are approved.
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API=false
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_ENABLED=false
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_TENANT_IDS=
# Delivery inspection start delegation stays disabled until the ledger
# extension and a tenant canary are approved.
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API=false
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_START_WRITES_ENABLED=false
ERP_DELIVERY_INSPECTION_START_WRITES_TENANT_IDS=
# Delivery inspection completion delegation stays disabled until the terminal
# Nest transaction and one tenant canary are approved.
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API=false
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_ENABLED=false
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_TENANT_IDS=
# Delivery cancellation delegation stays disabled until the cancellation
# transaction and one tenant canary are approved.
ERP_DELIVERY_CANCEL_WRITES_VIA_API=false
ERP_DELIVERY_CANCEL_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_CANCEL_WRITES_ENABLED=false
ERP_DELIVERY_CANCEL_WRITES_TENANT_IDS=
ERP_FINANCE_JOURNAL_POST_WRITES_VIA_API=false
ERP_FINANCE_JOURNAL_POST_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_JOURNAL_POST_WRITES_ENABLED=false
ERP_FINANCE_JOURNAL_POST_WRITES_TENANT_IDS=
# Journal reversal delegation stays disabled until its request ledger and
# tenant-scoped canary are approved.
ERP_FINANCE_JOURNAL_REVERSE_WRITES_VIA_API=false
ERP_FINANCE_JOURNAL_REVERSE_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_JOURNAL_REVERSE_WRITES_ENABLED=false
ERP_FINANCE_JOURNAL_REVERSE_WRITES_TENANT_IDS=
# Supplier Bill posting/reversal authorities stay disabled until ordered
# migration, disposable transaction, audit, and tenant-canary gates pass.
ERP_FINANCE_SUPPLIER_BILL_POST_WRITES_ENABLED=false
ERP_FINANCE_SUPPLIER_BILL_POST_WRITES_TENANT_IDS=
ERP_FINANCE_SUPPLIER_BILL_REVERSE_WRITES_ENABLED=false
ERP_FINANCE_SUPPLIER_BILL_REVERSE_WRITES_TENANT_IDS=
# Cash posting/reversal authority stays disabled until ordered migration,
# disposable transaction, audit, and tenant-canary gates pass.
ERP_FINANCE_CASH_WORKFLOW_WRITES_ENABLED=false
ERP_FINANCE_CASH_WORKFLOW_WRITES_TENANT_IDS=
# Cash draft create/update/delete authority stays disabled until ordered
# migration, disposable transaction, audit, and tenant-canary gates pass.
ERP_FINANCE_CASH_DRAFT_WRITES_ENABLED=false
ERP_FINANCE_CASH_DRAFT_WRITES_TENANT_IDS=
ERP_FINANCE_CUSTOMER_INVOICE_ISSUE_WRITES_ENABLED=false
ERP_FINANCE_CUSTOMER_INVOICE_ISSUE_WRITES_TENANT_IDS=
# Customer invoice draft creation authority stays disabled until the Nest
# transaction, idempotency replay, audit, and tenant-canary gates pass.
ERP_FINANCE_CUSTOMER_INVOICE_DRAFT_CREATE_WRITES_ENABLED=false
ERP_FINANCE_CUSTOMER_INVOICE_DRAFT_CREATE_WRITES_TENANT_IDS=
# Customer invoice reversal authority stays disabled until the Nest
# transaction, request ledger, audit, and tenant-canary gates pass.
ERP_FINANCE_CUSTOMER_INVOICE_REVERSE_WRITES_ENABLED=false
ERP_FINANCE_CUSTOMER_INVOICE_REVERSE_WRITES_TENANT_IDS=
# Customer invoice cancellation authority stays disabled until the Nest
# transaction, request ledger, audit, and tenant-canary gates pass.
ERP_FINANCE_CUSTOMER_INVOICE_CANCEL_WRITES_ENABLED=false
ERP_FINANCE_CUSTOMER_INVOICE_CANCEL_WRITES_TENANT_IDS=
# Next-side selector for the Nest/BullMQ CAD processing canary. Keep disabled
# until the API processing, worker bridge, evidence commit, and rollback gates
# are approved for one tenant.
ERP_DOCUMENT_PROCESSING_VIA_API=false
ERP_DOCUMENT_PROCESSING_TENANT_IDS=
ERP_DOCUMENT_DELETE_WRITES_VIA_API=false
ERP_DOCUMENT_DELETE_WRITES_VIA_API_TENANT_IDS=
# Recovery scheduler stays disabled and unscoped until all processing gates
# and a tenant-specific canary are approved.
ERP_DOCUMENT_PROCESSING_RECOVERY_ENABLED=false
ERP_DOCUMENT_PROCESSING_RECOVERY_TENANT_IDS=
# Document deletion canary. Keep closed and unscoped until the Nest
# transaction, idempotency replay, Storage cleanup, and rollback gates pass.
ERP_DOCUMENT_DELETE_WRITES_ENABLED=false
ERP_DOCUMENT_DELETE_WRITES_TENANT_IDS=
# Public canvas-signing authority canary. Keep closed until token replay,
# Storage, transaction, and rollback proof pass for one tenant.
ERP_PUBLIC_SIGNING_WRITES_ENABLED=false
ERP_PUBLIC_SIGNING_WRITES_TENANT_IDS=
# Public supplier-confirmation authority canary. Keep closed and unscoped
# until the response state machine, replay, and rollback gates pass.
ERP_PUBLIC_VENDOR_CONFIRMATION_WRITES_ENABLED=false
ERP_PUBLIC_VENDOR_CONFIRMATION_WRITES_TENANT_IDS=
# Public supplier review read seam. Keep closed until hosted supplier schema
# and token threat-model gates pass.
ERP_PUBLIC_VENDOR_CONFIRMATION_READ_ENABLED=false
ERP_PUBLIC_VENDOR_CONFIRMATION_READ_TENANT_IDS=
# Session minting is a closed SCM-issuance seam. Keep disabled until the
# source-only migration, replay, expiry, and rollback gates clear. The raw
# token secret is server-only and is never written to the database.
ERP_PUBLIC_VENDOR_CONFIRMATION_SESSION_MINTING_ENABLED=false
ERP_PUBLIC_VENDOR_CONFIRMATION_SESSION_MINTING_TENANT_IDS=
ERP_PUBLIC_VENDOR_CONFIRMATION_TOKEN_SECRET=
ERP_PUBLIC_VENDOR_CONFIRMATION_SESSION_TTL_HOURS=720
# Confirmation links require the public-write gate and the same tenant
# allowlist. Keep closed until hosted schema, replay, expiry, and provider
# canary gates are approved.
ERP_PUBLIC_VENDOR_CONFIRMATION_LINK_DELIVERY_ENABLED=false
ERP_PUBLIC_VENDOR_CONFIRMATION_LINK_DELIVERY_TENANT_IDS=
ERP_PUBLIC_VENDOR_CONFIRMATION_BASE_URL=
# Next-side selector for the public signing canary. Keep disabled until the
# Nest route is deployed and the portal handoff is verified.
ERP_PUBLIC_SIGNING_VIA_API=false
ERP_PUBLIC_SIGNING_VIA_API_TENANT_IDS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
REDIS_URL=redis://localhost:6379
ERP_API_CORS_ORIGINS=http://localhost:3000

# Supabase Storage
SUPABASE_STORAGE_BUCKET=project-documents

# Optional: Upstash Redis (rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Inngest (background jobs)
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DXF Parser Worker (Railway)
# DXF_PARSER_URL=https://your-dxf-parser.railway.app

# Optional Python AI Worker (server-only; worker-first embeddings when both set)
# AI_WORKER_URL=https://your-ai-worker.railway.app
# AI_WORKER_SHARED_SECRET=
# AI_WORKER_TIMEOUT_MS=15000

# OpenAI (required for AI BOM suggestions and project chat)
# Enables: similar item retrieval, streaming chat, BOM embedding on approval
OPENAI_API_KEY=sk-...
