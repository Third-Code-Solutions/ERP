# ============================================
# Third Code ERP Construction ERP — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Public application origin. Set this to the canonical production hostname for
# metadata, structured data, portal links, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres direct connection)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# NestJS ERP Core API (feature-flagged migration path)
ERP_CORE_API_URL=http://localhost:3001
ERP_PROJECT_WRITES_VIA_API=false
ERP_PO_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_CREATE_WRITES_VIA_API=false
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API=false
ERP_INVENTORY_RECEIPT_CREATE_VIA_API=false
ERP_INVENTORY_RECEIPT_CREATE_TENANT_IDS=
# Keep Stock Receipt posting/reversal delegated writes disabled until the
# Nest transaction, idempotency, authorization, and rollback gates are approved.
ERP_INVENTORY_RECEIPT_POST_VIA_API=false
ERP_INVENTORY_RECEIPT_POST_TENANT_IDS=
ERP_INVENTORY_RECEIPT_REVERSE_VIA_API=false
ERP_INVENTORY_RECEIPT_REVERSE_TENANT_IDS=
ERP_PO_CREATE_WRITES_ENABLED=false
ERP_PO_BOM_CREATE_WRITES_ENABLED=false
ERP_PO_BOM_GROUPED_CREATE_WRITES_ENABLED=false
# Comma-separated tenant UUIDs. Keep empty until PO transaction canary is approved.
ERP_PO_CREATE_WRITES_TENANT_IDS=
ERP_PO_BOM_CREATE_WRITES_TENANT_IDS=
ERP_PO_BOM_GROUPED_CREATE_WRITES_TENANT_IDS=
ERP_CHANGE_REQUEST_WRITES_ENABLED=false
ERP_CHANGE_REQUEST_WRITES_TENANT_IDS=
ERP_PO_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_CREATE_WRITES_VIA_API_TENANT_IDS=
ERP_PO_BOM_GROUPED_CREATE_WRITES_VIA_API_TENANT_IDS=
# Keep workflow delegation disabled until notification parity and canary proof.
ERP_PO_WORKFLOW_WRITES_VIA_API=false
ERP_PO_WORKFLOW_WRITES_VIA_API_TENANT_IDS=
# Keep PO approval transitions disabled until hosted reconciliation and canary.
ERP_PO_WORKFLOW_WRITES_ENABLED=false
ERP_PO_WORKFLOW_WRITES_TENANT_IDS=
ERP_PO_WORKFLOW_NOTIFICATIONS_ENABLED=false
ERP_PO_WORKFLOW_NOTIFICATIONS_TENANT_IDS=
# Delivery receipt delegation stays disabled until the new request ledger and
# a tenant canary are approved.
ERP_DELIVERY_RECEIPT_WRITES_VIA_API=false
ERP_DELIVERY_RECEIPT_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_RECEIPT_WRITES_ENABLED=false
ERP_DELIVERY_RECEIPT_WRITES_TENANT_IDS=
# Delivery site-preparation start delegation stays disabled until the ledger
# extension and a tenant canary are approved.
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API=false
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_ENABLED=false
ERP_DELIVERY_SITE_PREPARATION_START_WRITES_TENANT_IDS=
# Delivery inspection start delegation stays disabled until the ledger
# extension and a tenant canary are approved.
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API=false
ERP_DELIVERY_INSPECTION_START_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_START_WRITES_ENABLED=false
ERP_DELIVERY_INSPECTION_START_WRITES_TENANT_IDS=
# Delivery inspection completion delegation stays disabled until the terminal
# Nest transaction and one tenant canary are approved.
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API=false
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_ENABLED=false
ERP_DELIVERY_INSPECTION_COMPLETE_WRITES_TENANT_IDS=
# Delivery cancellation delegation stays disabled until the cancellation
# transaction and one tenant canary are approved.
ERP_DELIVERY_CANCEL_WRITES_VIA_API=false
ERP_DELIVERY_CANCEL_WRITES_VIA_API_TENANT_IDS=
ERP_DELIVERY_CANCEL_WRITES_ENABLED=false
ERP_DELIVERY_CANCEL_WRITES_TENANT_IDS=
ERP_FINANCE_JOURNAL_POST_WRITES_VIA_API=false
ERP_FINANCE_JOURNAL_POST_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_JOURNAL_POST_WRITES_ENABLED=false
ERP_FINANCE_JOURNAL_POST_WRITES_TENANT_IDS=
# Journal reversal delegation stays disabled until its request ledger and
# tenant-scoped canary are approved.
ERP_FINANCE_JOURNAL_REVERSE_WRITES_VIA_API=false
ERP_FINANCE_JOURNAL_REVERSE_WRITES_VIA_API_TENANT_IDS=
ERP_FINANCE_JOURNAL_REVERSE_WRITES_ENABLED=false
ERP_FINANCE_JOURNAL_REVERSE_WRITES_TENANT_IDS=
# Supplier Bill posting/reversal authorities stay disabled until ordered
# migration, disposable transaction, audit, and tenant-canary gates pass.
ERP_FINANCE_SUPPLIER_BILL_POST_WRITES_ENABLED=false
ERP_FINANCE_SUPPLIER_BILL_POST_WRITES_TENANT_IDS=
ERP_FINANCE_SUPPLIER_BILL_REVERSE_WRITES_ENABLED=false
ERP_FINANCE_SUPPLIER_BILL_REVERSE_WRITES_TENANT_IDS=
# Next-side selector for the Nest/BullMQ CAD processing canary. Keep disabled
# until the API processing, worker bridge, evidence commit, and rollback gates
# are approved for one tenant.
ERP_DOCUMENT_PROCESSING_VIA_API=false
ERP_DOCUMENT_PROCESSING_TENANT_IDS=
# Recovery scheduler stays disabled and unscoped until all processing gates
# and a tenant-specific canary are approved.
ERP_DOCUMENT_PROCESSING_RECOVERY_ENABLED=false
ERP_DOCUMENT_PROCESSING_RECOVERY_TENANT_IDS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
REDIS_URL=redis://localhost:6379
ERP_API_CORS_ORIGINS=http://localhost:3000

# Supabase Storage
SUPABASE_STORAGE_BUCKET=project-documents

# Optional: Upstash Redis (rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Inngest (background jobs)
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DXF Parser Worker (Railway)
# DXF_PARSER_URL=https://your-dxf-parser.railway.app

# Optional Python AI Worker (server-only; worker-first embeddings when both set)
# AI_WORKER_URL=https://your-ai-worker.railway.app
# AI_WORKER_SHARED_SECRET=
# AI_WORKER_TIMEOUT_MS=15000

# OpenAI (required for AI BOM suggestions and project chat)
# Enables: similar item retrieval, streaming chat, BOM embedding on approval
OPENAI_API_KEY=sk-...
