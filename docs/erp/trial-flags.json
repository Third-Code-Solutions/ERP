{
  "_comment": "Per-tenant Core switches a trial tenant needs. Read by scripts/check-trial-flags.mjs and guarded by scripts/lib/trial-flags.test.mjs. features = switches to turn on; presence = variables that must exist (value never printed); leaveOff = every other *_TENANT_IDS variable, deliberately left closed for trial tenants (the web falls back to its direct path). A new *_TENANT_IDS variable in the code fails the contract test until it is placed here or in a feature.",
  "features": [
    {
      "id": "project-create",
      "label": "Create a project",
      "required": true,
      "api": [
        {
          "enabled": "ERP_PROJECT_CREATE_WRITES_ENABLED",
          "tenantIds": "ERP_PROJECT_CREATE_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Core replies \"Project creation is not enabled for this tenant; no Project was created.\""
    },
    {
      "id": "project-retire",
      "label": "Retire (delete) a project",
      "required": true,
      "api": [
        {
          "enabled": "ERP_PROJECT_DELETE_WRITES_ENABLED",
          "tenantIds": "ERP_PROJECT_DELETE_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Core replies \"Project deletion is not enabled for this tenant; no project was retired.\""
    },
    {
      "id": "cost-entry-create",
      "label": "Record a project cost entry",
      "required": true,
      "api": [
        {
          "enabled": "ERP_COST_ENTRY_CREATE_WRITES_ENABLED",
          "tenantIds": "ERP_COST_ENTRY_CREATE_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Core replies \"Cost entry creation is not enabled for this tenant; no cost entry was created.\""
    },
    {
      "id": "cost-entry-void",
      "label": "Void a project cost entry",
      "required": true,
      "api": [
        {
          "enabled": "ERP_COST_ENTRY_DELETE_WRITES_ENABLED",
          "tenantIds": "ERP_COST_ENTRY_DELETE_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Core replies \"Cost entry deletion is not enabled for this tenant; no cost entry was changed.\""
    },
    {
      "id": "cost-entry-restore",
      "label": "Restore a voided cost entry",
      "required": true,
      "api": [
        {
          "enabled": "ERP_COST_ENTRY_RESTORE_WRITES_ENABLED",
          "tenantIds": "ERP_COST_ENTRY_RESTORE_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Core replies \"Cost entry restoration is not enabled for this tenant; no cost entry was changed.\" No screen restores an entry yet; the flag is set so a later release needs no variable change."
    },
    {
      "id": "customer-invoice-draft",
      "label": "Create a customer invoice draft from a project",
      "required": true,
      "api": [
        {
          "enabled": "ERP_FINANCE_CUSTOMER_INVOICE_DRAFT_CREATE_WRITES_ENABLED",
          "tenantIds": "ERP_FINANCE_CUSTOMER_INVOICE_DRAFT_CREATE_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Core replies \"Customer invoice draft creation is not enabled for this tenant; no invoice was created.\""
    },
    {
      "id": "opportunity-stage",
      "label": "Create an opportunity and move it between pipeline stages",
      "required": true,
      "api": [
        {
          "enabled": "ERP_OPPORTUNITY_STAGE_WRITES_ENABLED",
          "tenantIds": "ERP_OPPORTUNITY_STAGE_WRITES_TENANT_IDS"
        }
      ],
      "web": [
        {
          "enabled": "ERP_OPPORTUNITY_STAGE_WRITES_VIA_API",
          "tenantIds": "ERP_OPPORTUNITY_STAGE_WRITES_VIA_API_TENANT_IDS",
          "wildcard": true
        }
      ],
      "symptom": "Pipeline move fails with \"Opportunity stage transition is not enabled for this tenant.\" (web) or Core replies \"Opportunity stage transitions are not enabled for this tenant; no stage change was committed.\""
    },
    {
      "id": "opportunity-convert",
      "label": "Won opportunity creates its project",
      "required": true,
      "api": [
        {
          "enabled": "ERP_OPPORTUNITY_CONVERT_WRITES_ENABLED",
          "tenantIds": "ERP_OPPORTUNITY_CONVERT_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Moving a deal to Won fails; Core replies \"Won-to-Project handoff is not enabled for this tenant; no Project was created.\""
    },
    {
      "id": "admin-role-change",
      "label": "Change a user role",
      "required": true,
      "api": [
        {
          "enabled": "ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_ENABLED",
          "tenantIds": "ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_TENANT_IDS"
        }
      ],
      "web": [
        {
          "enabled": "ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_VIA_API",
          "tenantIds": "ERP_ADMIN_USER_ROLE_ASSIGNMENT_WRITES_VIA_API_TENANT_IDS",
          "wildcard": true
        }
      ],
      "symptom": "Admin > Users shows \"Core role changes are not enabled for this workspace. No role change was submitted.\" (web) or Core replies \"User role assignment is not enabled for this tenant; no role was changed.\""
    },
    {
      "id": "cad-evidence-commit",
      "label": "Commit CAD drawing evidence as scope items (only if the tenant uses drawings)",
      "required": false,
      "api": [
        {
          "enabled": "ERP_CAD_EVIDENCE_COMMIT_WRITES_ENABLED",
          "tenantIds": "ERP_CAD_EVIDENCE_COMMIT_WRITES_TENANT_IDS"
        }
      ],
      "web": [],
      "symptom": "Drawing upload completes but Core replies \"CAD evidence commit is not enabled for this tenant; no scope items were created.\""
    }
  ],
  "presence": [
    {
      "id": "core-api-url",
      "label": "Web knows where the Core API is",
      "host": "web",
      "required": true,
      "variables": [
        "ERP_CORE_API_URL"
      ],
      "symptom": "Every Core-backed action fails with \"ERP Core API is not configured.\""
    },
    {
      "id": "web-mail",
      "label": "Web can send email (invites, notices)",
      "host": "web",
      "required": true,
      "variables": [
        "RESEND_API_KEY",
        "EMAIL_FROM"
      ],
      "symptom": "Settings > Integrations reports \"Email delivery is unavailable until a sender and API key are configured.\""
    },
    {
      "id": "web-inngest",
      "label": "Web can schedule background workflows",
      "host": "web",
      "required": true,
      "variables": [
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY"
      ],
      "symptom": "Settings > Integrations reports \"Background workflows require configuration and an app sync.\""
    },
    {
      "id": "api-mail",
      "label": "Core API can send email",
      "host": "api",
      "required": false,
      "variables": [
        "RESEND_API_KEY",
        "EMAIL_FROM"
      ],
      "symptom": "Core-sent notifications are not delivered by email."
    }
  ],
