{
  "name": "third-code-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:build-ops-invariants": "node --test scripts/verify-build-ops-invariants.test.mjs",
    "test:abi-ops-brand": "node --test scripts/verify-abi-ops-brand.test.mjs",
    "test:type-safety": "node --test scripts/verify-type-safety.test.mjs",
    "test:app-router-boundaries": "node --test scripts/verify-app-router-boundaries.test.mjs",
    "test:production-surface": "node --test scripts/verify-production-surface.test.mjs",
    "test:demo-tenant": "node --test scripts/lib/demo-tenant.test.mjs",
    "test:database-release-plan": "node --test scripts/plan-database-release.test.mjs",
    "test:project-cutover-plan": "node --test scripts/plan-project-cutover.test.mjs",
    "test:wo-02-sql-proposal": "node --test scripts/verify-wo-02-sql-proposal.test.mjs",
    "test:wo-04-migration": "node --test scripts/verify-wo-04-migration.test.mjs",
    "test:wo-05-migration": "node --test scripts/verify-wo-05-migration.test.mjs",
    "test:wo-06-migration": "node --test scripts/verify-wo-06-migration.test.mjs",
    "test:process-sla-sql": "node --test scripts/verify-process-sla-migration.test.mjs",
    "ci:actionlint": "node scripts/run-actionlint.mjs",
    "ci:gitleaks": "node scripts/run-gitleaks.mjs",
    "plan:database-release": "node scripts/plan-database-release.mjs",
    "plan:database-release:full": "node scripts/plan-database-release.mjs --require-current --require-wo-02",
    "plan:provider-database-release": "node scripts/plan-provider-database-release.mjs",
    "verify:release-source": "node scripts/verify-release-source.mjs",
    "plan:project-cutover": "node scripts/plan-project-cutover.mjs",
    "verify:build-ops-invariants": "node scripts/verify-build-ops-invariants.mjs",
    "verify:abi-ops-brand": "node scripts/verify-abi-ops-brand.mjs",
    "verify:type-safety": "node scripts/verify-type-safety.mjs",
    "verify:app-router-boundaries": "node scripts/verify-app-router-boundaries.mjs",
    "verify:production-surface": "node scripts/verify-production-surface.mjs",
    "verify:build-ops-data": "node scripts/verify-build-ops-invariants.mjs --database",
    "verify:audit-coverage": "node scripts/verify-audit-coverage.mjs",
    "verify:wo-02-database": "node scripts/verify-wo-02-database.mjs",
    "verify:wo-04-database": "node scripts/verify-wo-04-database.mjs",
    "verify:wo-05-database": "node scripts/verify-wo-05-database.mjs",
    "verify:wo-06-database": "node scripts/verify-wo-06-database.mjs",
    "verify:wo-06-database-behavior": "node scripts/verify-wo-06-database-behavior.mjs",
    "audit:build-ops-demo-data": "node scripts/audit-build-ops-demo-data.mjs",
    "verify:workflow-action-refs": "node scripts/verify-workflow-action-refs.mjs",
    "clean": "turbo clean && find . -name 'node_modules' -type d -not -path './.git/*' -exec rm -rf {} + 2>/dev/null; find . -name '.next' -type d -exec rm -rf {} + 2>/dev/null; true"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
